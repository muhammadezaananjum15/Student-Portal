# ==========================================
# Unified Git Ignore (Frontend + Backend)
# ==========================================

# Dependencies
node_modules/
frontend/node_modules/
Backend/node_modules/
.pnp/
.pnp.js

# Environment & Secrets (MongoDB, API keys, etc.)
.env
.env.*
*.env
!.env.example

# Production & Build Outputs
build/
dist/
out/
frontend/build/
frontend/dist/

# File Uploads (Backend Multer student uploads)
uploads/*
Backend/uploads/*
!Backend/uploads/.gitkeep
!uploads/.gitkeep

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
